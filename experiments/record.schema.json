              "assetVersion": {
                "type": "string"
              },
              "settings": {
                "$ref": "#/$defs/settings"
              },
              "device": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
