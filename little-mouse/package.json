  },
  "dependencies": {
    "@babylonjs/core": "9.37.1",
    "@babylonjs/materials": "9.37.1",
    "three": "^0.181.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "4.10.3"
  }
}
